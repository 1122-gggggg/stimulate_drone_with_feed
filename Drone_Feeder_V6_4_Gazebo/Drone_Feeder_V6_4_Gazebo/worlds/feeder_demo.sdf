<?xml version="1.0"?>
<sdf version="1.7">
  <world name="feeder_demo">
    <physics name="default" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.85 0.88 0.92 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.3 -1</direction><cast_shadows>true</cast_shadows>
    </light>
    <model name="ground_plane">
      <static>true</static><link name="ground">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include><uri>model://drone_feeder_v64</uri><pose>0 0 0.359000000 0 0 0</pose></include>
  </world>
</sdf>
